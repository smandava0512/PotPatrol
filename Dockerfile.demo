# Temporary CPU-only integration demo: synthetic worker mode; not real pothole inference.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml alembic.ini ./
COPY potpatrol ./potpatrol
COPY migrations ./migrations
COPY worker ./worker
RUN python -m pip install --no-cache-dir . \
    && python -m pip install --no-cache-dir --no-deps ./worker numpy av opencv-python-headless \
    && mkdir -p /data/media && chown -R 10001:10001 /data
USER 10001:10001
