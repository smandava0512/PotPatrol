# CPU-only PotPatrol API and real/fixture vision worker for the isolated AWS demo.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HOME=/data/model-cache/huggingface \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml alembic.ini ./
COPY potpatrol ./potpatrol
COPY migrations ./migrations
COPY worker ./worker
RUN python -m pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir . ./worker \
    && mkdir -p /data/media /data/model-cache && chown -R 10001:10001 /data
USER 10001:10001
